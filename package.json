{
  "name": "dsh-sheet-diff",
  "version": "0.2.1",
  "description": "Read-only, key-aligned spreadsheet review for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/po-et/dsh-sheet-diff.git" },
  "homepage": "https://github.com/po-et/dsh-sheet-diff#readme",
  "bugs": { "url": "https://github.com/po-et/dsh-sheet-diff/issues" },
  "engines": { "node": ">=24.9.0" },
  "main": "./src/plugin.js",
  "exports": { ".": "./src/plugin.js", "./core": "./src/compare.js", "./report": "./src/report.js", "./review": "./src/review.js", "./handoff": "./src/handoff.js" },
  "bin": { "sheet-diff": "./src/cli.js" },
  "files": ["src/", "skills/", "cordis.patch.yml", "docs/review-demo.jpg", "README.md", "CHANGELOG.md", "SECURITY.md", "LICENSE"],
  "keywords": ["dsh-plugin", "dsh-skill", "spreadsheet", "xlsx", "csv", "diff", "review"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node scripts/demo.js",
    "smoke:host": "node --expose-internals scripts/host-smoke.js",
    "smoke:profile": "node --expose-internals scripts/profile-smoke.js"
  },
  "dependencies": { "exceljs": "4.4.0", "yauzl": "3.4.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.3",
    "yaml": "2.9.1"
  }
}
